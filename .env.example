# canvas-reader configuration — copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored. Never commit real credentials.

# Your school's Canvas base URL (required)
CANVAS_HOST="https://yourschool.instructure.com"

# Option A — API token, if your school allows it
# (Canvas → Account → Profile → Approved Integrations)
# CANVAS_API_TOKEN="PASTE_THE_TOKEN_HERE"

# Option B — session cookie, works at schools that disable tokens
# (log in to Canvas, F12 → Application → Cookies → copy _canvas_session)
# CANVAS_SESSION="PASTE_THE_COOKIE_VALUE_HERE"

# Optional: where synced content is written (default: ./content)
# CONTENT_DIR=content

# Optional: shared folder of course textbooks (Windows: Z:\Textbooks,
# WSL: /mnt/z/Textbooks) — agents read PDFs from here
# TEXTBOOKS_DIR=
